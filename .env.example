# Postgres (e.g. on the Unraid server): create an empty "docket" database first
DATABASE_URL="postgresql://USER:PASSWORD@192.168.7.2:5432/docket?schema=public"

# Better Auth: a long random string (e.g. `openssl rand -base64 32`) and the public URL of the app
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional: other addresses Docket is opened on, comma-separated
DOCKET_TRUSTED_ORIGINS=""

# Where uploaded files (manuals, receipts, photos) are stored: a mounted volume in Docker
UPLOAD_DIR="./data/uploads"
# Nightly backups of the database and uploads (lib/backup.ts); put them on a different disk from the uploads
BACKUP_DIR="./data/backups"
# Optional: how many nightly database backups to keep (14), the hour they run from (3), or BACKUP_DISABLED=1
# BACKUP_KEEP=14
# BACKUP_HOUR=3
